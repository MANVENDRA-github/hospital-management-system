# Copy this file to .env and adjust values as needed.
# `docker compose up` reads .env automatically.

# ---------- Postgres ----------
POSTGRES_USER=hms
POSTGRES_PASSWORD=hms_pw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------- RabbitMQ ----------
RABBITMQ_USER=hms
RABBITMQ_PASSWORD=hms_pw
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# ---------- JWT ----------
# Base64-encoded secret. Generate your own for any non-local environment:
#   openssl rand -base64 64
JWT_SECRET=Y2hhbmdlLW1lLWxvY2FsLWRldi1zZWNyZXQtaG9zcGl0YWwtbWFuYWdlbWVudC1zeXN0ZW0tMjAyNg==
JWT_EXPIRATION_MS=86400000

# ---------- Eureka ----------
EUREKA_HOST=eureka-server
EUREKA_PORT=8761

# ---------- Default seeded admin (auth-service) ----------
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin@123
